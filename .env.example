# # ==============================
# # Application Settings
# # ==============================
# APP_URL=https://makkpressapps.com/squarespace/googlesearchconsole
# BASE_URL=https://makkpressapps.com/squarespace/googlesearchconsole
# APP_ENV=production
# APP_DEBUG=0
# APP_TIMEZONE=UTC

APP_ENV=production
APP_DEBUG=0
APP_URL=https://makkpressapps.com/squarespace/googlesearchconsole
BASE_URL=https://makkpressapps.com/squarespace/googlesearchconsole
APP_TIMEZONE=UTC

DB_HOST=localhost
DB_PORT=3306
DB_NAME=squarespace-googlesearchconsole
DB_USER=root
DB_PASS=Makkpress@123AA


# ==============================
# Security
# ==============================
ENCRYPTION_SECRET=COPY_SAME_VALUE_AS_ECWID_ENV_SEE_BELOW


GHL_WEBHOOK_SECRET=COPY_SAME_VALUE_AS_ECWID_ENV


# ==============================
# Google OAuth
# (redirect URI: APP_URL/google_oauth_callback.php —
#  isko Google Cloud ke OAuth client me add karna hai)
# ==============================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://makkpressapps.com/squarespace/googlesearchconsole/google_oauth_callback.php
GSC_SCOPES=https://www.googleapis.com/auth/webmasters.readonly https://www.googleapis.com/auth/webmasters


# ==============================
# Mail (magic links)
# ==============================
MAIL_FROM=noreply@makkpressapps.com
