# Squarespace GSC App — Environment Configuration
# Copy this file to .env and fill in your values

# Database
DB_HOST=localhost
DB_NAME=squarespace_googlesearchconsole
DB_USER=root
DB_PASS=

# Encryption (AES-256-CBC) — Change this to a strong random key!
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-domain.com/gsc-app-squarespace/google_oauth_callback.php
GSC_SCOPES=https://www.googleapis.com/auth/webmasters.readonly https://www.googleapis.com/auth/webmasters

# Stripe
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# App
APP_BASE=/gsc-app-squarespace
APP_NAME=Google Search Console — Squarespace
APP_PLATFORM=squarespace

