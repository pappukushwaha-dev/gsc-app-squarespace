# ============================================
# Squarespace GSC App — environment
# Copy to .env and fill in real values.
# ============================================

APP_ENV=production
APP_DEBUG=0
APP_URL=https://makkpressapps.com/squarespace/googlesearchconsole
BASE_URL=https://makkpressapps.com/squarespace/googlesearchconsole

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=squarespace-googlesearchconsole
DB_USER=squarespace
DB_PASS=CHANGE_ME

# --- Security (generate: php -r "echo bin2hex(random_bytes(32));") ---
ENCRYPTION_SECRET=CHANGE_ME_64_HEX_CHARS

# --- Google OAuth (redirect: APP_URL/google_oauth_callback.php) ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://makkpressapps.com/squarespace/googlesearchconsole/google_oauth_callback.php

# --- Stripe (checkout + webhook) ---
STRIPE_PUBLIC_KEY=pk_live_xxx
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Mail (magic links) ---
MAIL_FROM=noreply@makkpressapps.com
